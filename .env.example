# LocalStripe configuration. Copy to `.env` to override defaults; every value is optional.
# LocalStripe is a payment MOCK for development and testing. It never processes real payments.

# --- Ports (host side) ------------------------------------------------------
API_PORT=9001
DASHBOARD_PORT=3002
# 127.0.0.1 keeps LocalStripe reachable from this machine only. Use 0.0.0.0 to expose it on your network.
LOCALSTRIPE_BIND_ADDRESS=127.0.0.1
# Public URLs used in links (hosted checkout / 3DS pages). Derived from the ports when empty.
PUBLIC_API_URL=
DASHBOARD_URL=

# --- API keys -----------------------------------------------------------------
# Leave empty to let LocalStripe generate a key pair on first start (printed in `docker compose logs api`).
# Pin them to get stable keys for your app's .env or your CI (format: sk_test_<16+ chars>, pk_test_<16+ chars>).
LOCALSTRIPE_SECRET_KEY=
LOCALSTRIPE_PUBLISHABLE_KEY=

# --- Artificial delays --------------------------------------------------------
# Default time a confirmation takes to reach its outcome, in milliseconds.
PAYMENT_PROCESSING_DELAY_MS=0
# Per-scenario overrides: succeeded, declined, requires_action, processing.
# For `processing`, this is how long the payment stays in `processing` before it settles.
PAYMENT_SCENARIO_DELAYS=processing=5000
# Upper bound for any delay, including the per-request `LocalStripe-Delay-Ms` header.
MAX_DELAY_MS=60000
# Optional JSON file (mounted into the api container) that extends or replaces the test card catalog.
TEST_CARD_CATALOG_PATH=

# --- Webhooks -----------------------------------------------------------------
WEBHOOK_MAX_ATTEMPTS=5
# Backoff: base × 3^(attempt-1), capped at one hour.
WEBHOOK_RETRY_BASE_DELAY_MS=10000
WEBHOOK_TIMEOUT_MS=10000

# --- API behavior -------------------------------------------------------------
# Reject unknown request parameters like Stripe does. Set to false to ignore them instead.
STRICT_PARAMS=true
# Comma-separated list of origins allowed to call the API from a browser (e.g. http://localhost:5173).
CORS_ORIGINS=
# Requests per minute per API key (or IP).
RATE_LIMIT_MAX=1000
# Create clearly labelled demo data ("[Demo] ..." customers and payments) on first start.
SEED_DEMO_DATA=false
LOG_LEVEL=info

# --- Database (internal to Docker; not exposed on the host) -------------------
POSTGRES_USER=localstripe
POSTGRES_PASSWORD=localstripe
POSTGRES_DB=localstripe
