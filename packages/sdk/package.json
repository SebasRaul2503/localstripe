{
  "name": "@localstripe/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for LocalStripe, the local Stripe-like payment mock. Does not process real payments.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@localstripe/contracts": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "vitest": "^5.0.2"
  }
}
