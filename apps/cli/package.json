{
  "name": "@localstripe/cli",
  "version": "0.1.0",
  "private": true,
  "description": "Command line interface for LocalStripe.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "localstripe": "./dist/main.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@localstripe/contracts": "workspace:*",
    "@localstripe/sdk": "workspace:*",
    "commander": "^14.0.1"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "vitest": "^5.0.2"
  }
}
