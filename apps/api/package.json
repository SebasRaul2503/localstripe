{
  "name": "@localstripe/api",
  "version": "0.1.0",
  "private": true,
  "description": "LocalStripe HTTP API and background worker.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "localstripe-api": "./dist/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts --migrate",
    "migrate": "tsx src/migrate.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.9.2",
    "@localstripe/contracts": "workspace:*",
    "@scalar/fastify-api-reference": "^1.75.0",
    "fastify": "^5.12.7",
    "fastify-plugin": "^5.1.0",
    "fastify-type-provider-zod": "^6.1.0",
    "kysely": "^0.29.7",
    "node-pg-migrate": "^8.0.3",
    "pg": "^8.23.1",
    "pino": "^9.14.0",
    "prom-client": "^15.1.3",
    "qs": "^6.16.1",
    "ulid": "^3.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/pg": "^8.15.5",
    "@types/qs": "^6.14.0",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.20.6",
    "vitest": "^3.2.4"
  },
  "files": [
    "dist",
    "migrations"
  ]
}
