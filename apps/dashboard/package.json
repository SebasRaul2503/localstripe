{
  "name": "@localstripe/dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "LocalStripe web dashboard (React SPA) and its backend-for-frontend server.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/main.ts",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist-server/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "test:unit": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@fastify/http-proxy": "^11.3.0",
    "@fastify/static": "^8.2.0",
    "fastify": "^5.6.1"
  },
  "devDependencies": {
    "@localstripe/contracts": "workspace:*",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-query": "^5.90.2",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "jsdom": "^27.0.0",
    "lucide-react": "^1.48.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.9.3",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.20.6",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  },
  "files": [
    "dist",
    "dist-server"
  ]
}
